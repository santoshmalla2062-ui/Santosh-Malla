        },
        "subtotal": { "type": "number" },
        "discountAmount": { "type": "number" },
        "serviceChargeAmount": { "type": "number" },
        "vatAmount": { "type": "number" },
        "grandTotal": { "type": "number" },
        "paymentMethod": { "type": "string", "maxLength": 32 },
        "buyerName": { "type": "string", "maxLength": 120 },
        "buyerPan": { "type": "string", "maxLength": 32 },
        "issuedByName": { "type": "string", "maxLength": 120 },
        "items": {
          "type": "array",
          "description": "Returned order line items."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "creditNoteId",
        "businessId",
        "ownerUid",
        "createdByUid",
        "creditNoteNo",
        "originalOrderId",
        "originalInvoiceNo",
        "grandTotal",
        "createdAt"
      ]
    },
    "JournalEntryRecord": {
      "title": "Sharded Double-Entry General Ledger Voucher",
      "description": "Individual balanced double-entry journal entry stored in a dedicated subcollection to prevent 1 MB document limits in finance_records.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 2,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "businessId": {
          "type": "string",
          "minLength": 2,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "entryNumber": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "date": {
          "type": "string",
          "maxLength": 32
        },
        "bsDate": {
          "type": "string",
          "maxLength": 20
        },
        "referenceType": {
          "type": "string",
          "enum": ["POS_SALE", "CREDIT_NOTE", "EXPENSE", "KHATA_COLLECTION", "HOTEL_PAYMENT", "OPENING_BALANCE", "ADJUSTMENT"]
        },
        "referenceId": {
          "type": "string",
          "maxLength": 128
        },
        "referenceNo": {
          "type": "string",
          "maxLength": 64
        },
        "description": {
          "type": "string",
          "maxLength": 240
        },
        "lines": {
          "type": "array",
          "description": "Balanced Debit/Credit journal lines (max 30 lines per voucher)."
        },
        "totalDebit": { "type": "number" },
        "totalCredit": { "type": "number" },
        "createdByName": {
          "type": "string",
          "maxLength": 120
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "businessId",
        "ownerUid",
        "createdByUid",
        "entryNumber",
        "referenceType",
        "lines",
        "totalDebit",
        "totalCredit",
        "createdAt"
      ]
    },
    "AuditLogRecord": {
      "title": "Sharded Security & POS Audit Log Entry",
      "description": "Immutable per-event security and billing audit trail stored in a dedicated subcollection to keep admin_controls lightweight.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 2,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "businessId": {
          "type": "string",
          "minLength": 2,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "staffId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "staffName": {
          "type": "string",
          "maxLength": 120
        },
        "role": {
          "type": "string",
          "maxLength": 32
        },
        "action": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "targetRecordId": {
          "type": "string",
          "maxLength": 128
        },
        "details": {
          "type": "string",
          "maxLength": 400
        },
        "severity": {
          "type": "string",
          "enum": ["INFO", "WARNING", "CRITICAL"]
        },
        "timestamp": {
          "type": "string",
          "maxLength": 32
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "businessId",
        "ownerUid",
        "createdByUid",
        "staffId",
        "action",
        "severity",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/AdminRegistry" },
      "description": "Bootstrapped Master Owner document keyed by Firebase Auth UID."
    },
    "/businesses/{businessId}": {
      "schema": { "$ref": "#/entities/BusinessWorkspace" },
      "description": "Business configuration and owner-lock flags."
    },
    "/businesses/{businessId}/invites/{inviteId}": {
      "schema": { "$ref": "#/entities/StaffInvite" },
      "description": "Owner-issued Gmail invitations mapping specific employees to strict roles."
    },
    "/businesses/{businessId}/members/{memberUid}": {
      "schema": { "$ref": "#/entities/BusinessMember" },
      "description": "Verified members allowed on mobile/tablet/desktop terminals."
    },
    "/businesses/{businessId}/syncChannels/{channelId}": {
      "schema": { "$ref": "#/entities/SyncChannelState" },
      "description": "Role-tiered live real-time state channels syncing Mobile Waiter, Kitchen KDS, Inventory, and Billing Desk under strict 550 KB byte budgets."
    },
    "/businesses/{businessId}/orders/{orderId}": {
      "schema": { "$ref": "#/entities/FiscalOrderRecord" },
      "description": "Sharded per-order subcollection preventing 1 MB document limits across thousands of POS orders."
    },
    "/businesses/{businessId}/counters/{counterId}": {
      "schema": { "$ref": "#/entities/SequenceCounter" },
      "description": "Atomic transaction counters for concurrency-safe multi-device invoice, KOT, and credit note numbering."
    },
    "/businesses/{businessId}/creditNotes/{creditNoteId}": {
      "schema": { "$ref": "#/entities/CreditNoteRecord" },
      "description": "Sharded immutable IRD Annex-5 Credit Notes / Sales Returns linked to settled tax invoices."
    },
    "/businesses/{businessId}/journalEntries/{entryId}": {
      "schema": { "$ref": "#/entities/JournalEntryRecord" },
      "description": "Sharded double-entry General Ledger vouchers preventing 1 MB limits in finance_records."
    },
    "/businesses/{businessId}/auditLogs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLogRecord" },
      "description": "Sharded security & POS audit log events preventing 1 MB limits in admin_controls."
    }
  }
}
